[Unit]
Description=Assign static SpinSense AP IPv4 address on wlan0
BindsTo=sys-subsystem-net-devices-wlan0.device
After=sys-subsystem-net-devices-wlan0.device NetworkManager.service
Before=hostapd.service dnsmasq.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/ip addr replace 10.42.0.1/24 dev wlan0
ExecStart=/usr/sbin/ip link set wlan0 up

[Install]
WantedBy=multi-user.target
