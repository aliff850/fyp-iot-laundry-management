SPINSENSE_DB_USER=edge_user
SPINSENSE_DB_PASSWORD=REPLACE_LOCALLY
SPINSENSE_DB_NAME=edge_iot
SPINSENSE_CLOUD_BASE=https://your-render-service.onrender.com
